{
  "name": "@95gabor/cv",
  "version": "3.0.1",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/generate-llms-txt.mts",
    "build": "next build",
    "generate": "pnpm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:visual:ci": "percy exec -- pnpm run test:e2e:visual",
    "release": "semantic-release",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:seed": "tsx scripts/seed-from-yaml.mts",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --local > lib/supabase/types.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@percy/cli": "1.32.6",
    "@percy/playwright": "^1.1.2",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
